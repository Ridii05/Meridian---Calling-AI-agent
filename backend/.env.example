# Google Gemini API Key (free tier at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs API Key & Voice ID (https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Default voice below is "Rachel" — swap for any voice ID from your ElevenLabs library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: set to "http" if your ElevenLabs plan does not include Scribe Realtime WS
ELEVENLABS_STT_MODE=realtime

# Server config
HOST=0.0.0.0
PORT=8000